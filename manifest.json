{
  "manifest_version": 3,
  "name": "Offpx",
  "version": "2.0.0",
  "description": "Design QA for the live web. Measure spacing, read type and layout, and check any site at mobile, tablet and desktop sizes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Offpx: inspect this page (Alt+Shift+I)",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "20": "src/icons/icon-20.png",
      "24": "src/icons/icon-24.png",
      "32": "src/icons/icon-32.png"
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Toggle Offpx inspect mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
